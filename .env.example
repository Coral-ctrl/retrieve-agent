# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your key never ends up on GitHub.

# Create a key in the Claude Console: https://platform.claude.com
ANTHROPIC_API_KEY=

# claude-sonnet-5 is the default. claude-haiku-4-5 is cheaper for simple slides.
RETRIEVE_MODEL=claude-sonnet-5

# Safety limit on how many times the agent can call the model per file.
RETRIEVE_MAX_TURNS=20

# Where notes and run logs are written (relative to the project folder).
RETRIEVE_KNOWLEDGE_DIR=knowledge
RETRIEVE_LOGS_DIR=logs

# --- Phases 2-3: database (optional) ----------------------------------
# Leave DATABASE_URL unset to keep using file-only storage from Phase 1.
# With it set, `summarize` also stores topics in Postgres, and `review`
# lets you rate them. A free Neon Postgres project works: https://neon.tech
# -- copy its connection string here (needs the pgvector extension, which
# `python -m retrieve init-db` enables for you). A local Postgres works too.
DATABASE_URL=

# Optional. Create a key at https://dashboard.voyageai.com to embed topics
# so the same concept from different files is merged by meaning. Without it,
# topics are still stored and reviewable; matching is by exact title only.
# voyage-4-lite gets 200M free tokens/month, far more than this project
# will ever use -- so with a key set, embeddings cost nothing in practice.
VOYAGE_API_KEY=
RETRIEVE_EMBEDDING_MODEL=voyage-4-lite

# Cosine distance below which two topics are treated as the same concept
# and merged instead of saved twice. Lower = stricter matching.
RETRIEVE_DEDUP_THRESHOLD=0.10
