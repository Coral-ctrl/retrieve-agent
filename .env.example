# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your key never ends up on GitHub.

# --- How to reach Claude -----------------------------------------------
# "subscription" (default): summarize and ask run through the Claude Agent
# SDK signed in with your Claude Pro/Max plan, so usage comes out of the
# plan's monthly credit. "api": pay per token with the key below.
RETRIEVE_BACKEND=subscription

# For the subscription: run `claude setup-token` once and paste the token.
# Optional if you're already signed in to Claude Code on this machine.
CLAUDE_CODE_OAUTH_TOKEN=

# Backup for the subscription (or the main way to pay if RETRIEVE_BACKEND=api).
# Create a key in the Claude Console: https://platform.claude.com
# With the subscription backend this key is only used, with a notice, when
# the subscription path can't run (not signed in, plan limit reached).
ANTHROPIC_API_KEY=

# claude-sonnet-5 is the default. claude-haiku-4-5 is cheaper for simple slides.
RETRIEVE_MODEL=claude-sonnet-5

# Safety limit on how many times the agent can call the model per file.
RETRIEVE_MAX_TURNS=20

# Where notes and run logs are written (relative to the project folder).
RETRIEVE_KNOWLEDGE_DIR=knowledge
RETRIEVE_LOGS_DIR=logs

# --- Phases 2-3: database (optional) ----------------------------------
# Leave DATABASE_URL unset to keep using file-only storage from Phase 1.
# With it set, `summarize` also stores topics in Postgres, and `review`
# lets you rate them. A free Neon Postgres project works: https://neon.tech
# -- copy its connection string here (needs the pgvector extension, which
# `python -m retrieve init-db` enables for you). A local Postgres works too.
DATABASE_URL=

# Optional. Create a key at https://dashboard.voyageai.com to embed topics
# so the same concept from different files is merged by meaning. Without it,
# topics are still stored and reviewable; matching is by exact title only.
# voyage-4-lite comes with a one-time 200M free tokens per account (not
# monthly) -- roughly a million topics' worth, so embeddings cost nothing
# in practice for a project this size.
VOYAGE_API_KEY=
RETRIEVE_EMBEDDING_MODEL=voyage-4-lite

# Set to true to skip Voyage entirely, even with a key set above -- e.g.
# while developing, to avoid burning the free-token allowance on repeated
# test runs. Falls back to the same title-only dedup / keyword search used
# when there's no key at all. Independent of git branch or any other state,
# so it's safe to leave on in a local .env without affecting anyone else.
RETRIEVE_DISABLE_VOYAGE=false

# Cosine distance below which two topics are treated as the same concept
# and merged instead of saved twice. Lower = stricter matching.
RETRIEVE_DEDUP_THRESHOLD=0.10
